# ElasticMind environment configuration (copy to .env and edit)

# --- Backend ---
ELASTICMIND_ENV=development
ELASTICMIND_DB_URL=sqlite:///./backend/data/elasticmind.db
ELASTICMIND_LOG_LEVEL=INFO

# Control loop
ELASTICMIND_LOOP_INTERVAL_S=5
ELASTICMIND_POLICY=ml            # static | reactive | ml
ELASTICMIND_ACTUATOR=local       # local | aws
ELASTICMIND_MIN_INSTANCES=1
ELASTICMIND_MAX_INSTANCES=10
ELASTICMIND_CAPACITY_PER_INSTANCE=100
ELASTICMIND_TARGET_UTILIZATION=0.7
ELASTICMIND_HEADROOM=0.2
ELASTICMIND_SCALE_UP_COOLDOWN_S=30
ELASTICMIND_SCALE_DOWN_COOLDOWN_S=120

# Predictor
ELASTICMIND_MODEL_PATH=ml/models/artifacts/lightgbm_multihorizon.joblib
ELASTICMIND_HORIZON_MIN=15

# --- Target app ---
TARGET_APP_PORT=8001
TARGET_APP_CPU_BURN_MS=40

# --- Loadgen ---
LOADGEN_SPEED_FACTOR=10
LOADGEN_TRACE=ml/data/generated/diurnal.parquet
LOADGEN_PROFILE=diurnal
LOADGEN_DAYS=1
LOADGEN_BACKEND_URL=http://localhost:8000

# --- AWS (Phase 2) ---
# AWS_REGION=us-east-1
# ELASTICMIND_ECS_CLUSTER=elasticmind
# ELASTICMIND_ECS_SERVICE=elasticmind-target
# ELASTICMIND_MODEL_S3_URI=s3://elasticmind-models/lightgbm_multihorizon.joblib
