{
  "family": "elasticmind-target-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::804012660016:role/ElasticMindECSTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "elasticmind-target-app",
      "image": "804012660016.dkr.ecr.ap-south-1.amazonaws.com/elasticmind-target-app:demo",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8001,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=3)\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/elasticmind-target",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "target"
        }
      }
    }
  ]
}
